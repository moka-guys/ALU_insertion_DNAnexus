{
  "name": "alu_insertion_analysis_v2.1.0",
  "title": "ALU Insertion Analysis v2.1.0",
  "summary": "Runs ALU insertion analysis on a run folder",
  "version": "2.1.0",
  "inputSpec": [
    {
      "name": "reference_tar",
      "label": "Reference genome files (.tar.gz)",
      "class": "file",
      "optional": false,
      "patterns": ["*.tar.gz"],
      "help": "Tar.gz containing reference genome files (hs37d5.fa, .fai, .nhr, .nin, .nsq)",
      "default": {
        "$dnanexus_link": {
          "project": "project-J1g3b9Q0BfbvfX94Y8xzx0zg",
          "id": "file-J6FZ3080Bfbk6fYXx7pyvQ61"
        }
      }
    },
    {
      "name": "bed",
      "label": "BED file (optional)",
      "class": "file",
      "optional": true,
      "patterns": ["*.bed"],
      "default": {
        "$dnanexus_link": {
          "project": "project-ByfFPz00jy1fk6PjpZ95F27J",
          "id": "file-G1zzb780jy1zPQgJGYJjKB4Z"
        }
      },
      "help": "Optional BED file to restrict analysis to specific regions"
    },
    {
      "name": "window",
      "label": "Coverage window size (bp)",
      "class": "int",
      "optional": true,
      "default": 50,
      "help": "Coverage analysis window size in bp"
    },
    {
      "name": "polyA_window",
      "label": "PolyA window size (bp)",
      "class": "int",
      "optional": true,
      "default": 10,
      "help": "PolyA detection window size in bp"
    },
    {
      "name": "threshold",
      "label": "Coverage change threshold (%)",
      "class": "float",
      "optional": true,
      "default": 15.0,
      "help": "Coverage change threshold as a percentage"
    },
    {
      "name": "min_polyA_len",
      "label": "Minimum polyA length",
      "class": "int",
      "optional": true,
      "default": 10,
      "help": "Minimum polyA/T stretch length"
    },
    {
      "name": "merge_gap",
      "label": "Merge gap (bp)",
      "class": "int",
      "optional": true,
      "default": 1,
      "help": "Maximum gap for merging nearby variants"
    },
    {
      "name": "proximity",
      "label": "Proximity (bp)",
      "class": "int",
      "optional": true,
      "default": 10,
      "help": "Max distance from variant to keep coverage tract"
    },
    {
      "name": "verbose",
      "label": "Verbose logging",
      "class": "boolean",
      "optional": true,
      "default": false,
      "help": "Enable verbose logging"
    },
    {
      "name": "dx_project_id",
      "label": "DNAnexus project ID to scan",
      "class": "string",
      "optional": false,
      "help": "Project ID containing R134 BAM files to scan (scan results are logged, not yet used for processing)"
    }
  ],
  "outputSpec": [
    {
      "name": "clusters_txt",
      "label": "Clusters file",
      "class": "array:file",
      "patterns": ["*.clusters.txt"],
      "help": "Scramble cluster_identifier output",
      "optional": true
    },
    {
      "name": "vcf_gz",
      "label": "Compressed VCF",
      "class": "array:file",
      "patterns": ["*.vcf.gz"],
      "help": "Scramble VCF output (bgzipped)",
      "optional": true
    },
    {
      "name": "alu_vcf",
      "label": "ALU insertions VCF",
      "class": "array:file",
      "patterns": ["*_ALU_ins.vcf"],
      "help": "VCF filtered to ALU insertions only",
      "optional": true
    },
    {
      "name": "alu_analysis_csv",
      "label": "ALU analysis CSV",
      "class": "array:file",
      "patterns": ["*_ALU_analysis.csv"],
      "help": "Full ALU analysis results",
      "optional": true
    },
    {
      "name": "alu_analysis_high_confidence_csv",
      "label": "High confidence ALU analysis CSV",
      "class": "array:file",
      "patterns": ["*_ALU_analysis_high_confidence.csv"],
      "help": "High confidence ALU analysis results (BOTH evidence)",
      "optional": true
    },
    {
      "name": "alu_analysis_summary_txt",
      "label": "ALU Analysis Summary",
      "class": "array:file",
      "patterns": ["*_ALU_analysis_summary.txt"],
      "optional": true
    },
    {
      "name": "sequence_search_out",
      "label": "sequence_search_outputs",
      "class": "array:file",
      "patterns": ["*.txt"],
      "optional": true
    },
    {
    "name": "failed_samples_scramble",
    "label": "samples that failed scramble analysis",
    "class": "file",
    "patterns": ["*.txt"],
    "optional": true}
  ],
  "runSpec": {
    "systemRequirements": {
      "main": {
        "instanceType": "mem1_ssd1_v2_x8"
      }
    },
    "interpreter": "bash",
    "file": "src/ALU_analysis_dnanexus.sh",
    "distribution": "Ubuntu",
    "release": "20.04",
    "version": "0"
        },
    "access": {
      "network": [
        "*"
      ],
      "project": "VIEW",
      "allProjects": "VIEW"
    }
      }
